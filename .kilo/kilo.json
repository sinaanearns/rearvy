{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "firebase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firebase-tools@14.15.2",
        "experimental:mcp"
      ]
    },
    "jupyter": {
      "type": "remote",
      "url": "uvx mcp-jupyter --transport http --port 8090"
    }
  }
}
