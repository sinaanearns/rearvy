# Code Signing Environment Variables
# For development/testing, use a self-signed certificate
# For production, use a commercial certificate

# Path to code signing certificate (.pfx file)
# On Windows, use forward slashes: file://C:/path/to/cert.pfx
# WIN_CSC_LINK=file://C:/Users/sinaa/rearvy-dev-cert.pfx

# Certificate password
# WIN_CSC_KEY_PASSWORD=your-certificate-password

# Note: These are optional for development.
# If not set, builds will skip code signing (signAndEditExecutable will fallback)
# See CODE_SIGNING_SETUP.md for complete setup instructions

# Clicky voice transcription and Maria Voice Agent (local desktop server only)
# ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# ASSEMBLYAI_VOICE_AGENT_TOKEN_SECONDS=300
# ASSEMBLYAI_VOICE_AGENT_MAX_SESSION_SECONDS=900

# Work Platform desktop pairing/local jobs
# The website URL loaded by Electron in local development.
REARVY_DESKTOP_DEV_URL=http://localhost:3000/chat/new
REARVY_DESKTOP_UI_ORIGIN=http://localhost:3000
# Optional local API port. If busy, the desktop app falls back to a dynamic port.
REARVY_LOCAL_API_PORT=4000
