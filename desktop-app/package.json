{
  "name": "rearvy-desktop",
  "version": "0.1.2",
  "description": "Rearvy Desktop Application",
  "author": "Rearvy",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "node scripts/dev-electron.cjs",
    "dev:wait": "node scripts/dev-electron.cjs",
    "build": "electron-builder && node ../scripts/post-desktop-build.mjs",
    "build:win": "electron-builder --win && node ../scripts/post-desktop-build.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.18.0",
    "firebase-admin": "^13.8.0",
    "node-fetch": "^2.7.0",
    "robotjs": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9"
  },
  "build": {
    "appId": "com.rearvy.desktop",
    "productName": "Rearvy",
    "artifactName": "${productName}UserSetup-${arch}-${version}.${ext}",
    "directories": {
      "output": "../desktop-release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "local-server.cjs",
      "lib/**",
      "api-routes/**",
      "executor/**",
      "clicky-logic.cjs",
      "automation-integration.cjs",
      "workflows/**",
      "build/**",
      "../scripts/blender-mcp-bridge.mjs",
      "../public/favicon.ico",
      "../public/favicon.png",
      "../public/favicon.svg",
      "../public/rearvy-logo.png",
      "../public/apple-touch-icon.png",
      "../public/rearvy.ico",
      "../public/rearvy-wordmark.svg",
      "package.json"
    ],
    "protocols": {
      "name": "Rearvy",
      "schemes": [
        "rearvy"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mutalvita-cyber",
        "repo": "rearvy-desktop-releases"
      }
    ],
    "asarUnpack": [
      "**/node_modules/robotjs/**",
      "**/node_modules/node-window-manager/**",
      "**/node_modules/extract-file-icon/**"
    ],
    "icon": "../public/rearvy.ico",
    "extraResources": [
      {
        "from": "app-update.yml",
        "to": "."
      },
      {
        "from": "../website",
        "to": "website"
      }
    ],
    "win": {
      "icon": "../public/rearvy.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "menuCategory": "Rearvy",
      "shortcutName": "Rearvy",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "installerHeader": "build/nsis-header.bmp",
      "installerSidebar": "build/nsis-sidebar.bmp",
      "license": "build/license.txt",
      "installerIcon": "../public/rearvy.ico",
      "uninstallerIcon": "../public/rearvy.ico",
      "uninstallDisplayName": "Rearvy",
      "warningsAsErrors": false
    },
    "mac": {
      "extendInfo": {
        "NSCameraUsageDescription": "Rearvy needs camera access for local device workflows.",
        "NSMicrophoneUsageDescription": "Rearvy needs microphone access for local device workflows."
      }
    }
  },
  "optionalDependencies": {
    "@serialport/list": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "postcss": "8.5.15",
    "uuid": "11.1.1",
    "protobufjs": "7.6.1",
    "qs": "6.15.2"
  }
}
