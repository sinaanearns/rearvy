{
  "manifest_version": 3,
  "name": "Rearvy Browser Relay",
  "short_name": "Rearvy Relay",
  "version": "0.1.5",
  "description": "Attach Rearvy to your existing Chrome tab via a local CDP relay server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["agent-chip.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Rearvy Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
