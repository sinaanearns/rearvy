rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Trading monitor documents are user-owned subcollections.
    match /users/{userId}/trading_monitors/{monitorId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.user_id == userId
        && request.resource.data.chat_id is string
        && request.resource.data.symbol is string
        && request.resource.data.timeframe is string
        && request.resource.data.isActive == true
        && request.resource.data.startedAt is number
        && request.resource.data.errorCount is number;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.user_id == userId
        && request.resource.data.user_id == userId;

      allow delete: if request.auth != null
        && request.auth.uid == userId
        && resource.data.user_id == userId;
    }

    // Users can read their own trading audit logs.
    match /users/{userId}/trading_audit_log/{auditId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // FLERB AI - Desktop Automation Collections
    // User workflows (predefined and custom)
    match /users/{userId}/workflows/{workflowId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trusted workflows (auto-run approved workflows)
    match /users/{userId}/trusted_workflows/{workflowId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Execution state (current workflow state)
    match /users/{userId}/execution_state/{workflowId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Execution logs (audit trail for each step)
    match /users/{userId}/execution_logs/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // Pending approvals (workflows awaiting user action)
    match /users/{userId}/approvals_pending/{approvalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Execution approvals (record of approved workflows)
    match /users/{userId}/execution_approvals/{approvalId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // Execution rejections (record of rejected workflows)
    match /users/{userId}/execution_rejections/{rejectionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // Global audit logs (admin-only for compliance)
    match /audit_logs/{auditId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }

    // Knowledge Documents and Chunks
    match /knowledge_documents/{docId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    match /knowledge_chunks/{chunkId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
  }
}

