{
  "name": "rearvy2.0",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "cd desktop-app && npm run dev",
    "desktop:build": "cd desktop-app && npm run build",
    "dev:both": "concurrently -k -s first \"npm run dev\" \"wait-on http://localhost:3000 && npm run desktop:dev\"",
    "lint": "eslint .",
    "install:all": "npm install && cd desktop-app && npm install",
    "trading:smoke-phase1": "node scripts/trading/phase1-smoke.mjs",
    "trading:run-cycle": "node scripts/trading/run-monitor-cycle.mjs",
    "trading:setup-scheduler": "node scripts/trading/setup-scheduler.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/react": "^3.0.99",
