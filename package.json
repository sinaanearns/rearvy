{
  "name": "rearvy2.0",
  "version": "0.1.24",
  "private": true,
  "scripts": {
    "app:install": "npm run install:all",
    "app:run": "npm run dev:both",
    "app:run:web": "npm run dev:web",
    "app:run:desktop": "npm run dev:desktop",
    "app:build:win": "npm run desktop:build:win",
    "app:build:mac": "npm run desktop:build:mac",
    "dev:web": "cd website && npm run dev",
    "dev": "npm run dev:web",
    "dev:desktop": "cd desktop-app && npm run dev",
    "desktop:dev": "npm run dev:desktop",
    "dev:both": "node scripts/start-desktop-after-web.js",
    "blender:mcp-bridge": "node scripts/blender-mcp-bridge.mjs",
    "build:web": "npm install --include=dev --prefix website --no-audit --progress=false && npm run build --prefix website",
    "build:cloudflare": "npm install --include=dev --prefix website --no-audit --progress=false && npm run build:cloudflare --prefix website",
    "build:cloudflare:conditional": "node -e \"if (process.env.WORKERS_CI) { require('child_process').execSync('npm run build:cloudflare', { stdio: 'inherit' }); } else { console.log('Skipping Cloudflare OpenNext build outside Workers CI'); }\"",
    "build:desktop": "cd desktop-app && npm run build",
    "desktop:build:win": "node scripts/desktop/build-win.mjs",
    "desktop:build:mac": "node scripts/desktop/build-mac.mjs",
    "browser-extension:stage": "node scripts/stage-browser-extension.mjs",
    "build:desktop:conditional": "node scripts/build-desktop-conditional.mjs",
    "build:web:vercel:sync-output": "node -e \"if (process.env.VERCEL) { const fs = require('fs'); const src = 'website/.next'; const dest = '.next'; if (!fs.existsSync(src)) { throw new Error('Expected Next output at website/.next'); } fs.rmSync(dest, { recursive: true, force: true }); fs.cpSync(src, dest, { recursive: true }); console.log('Synced website/.next to .next for Vercel runtime detection'); }\"",
    "build": "node scripts/build-root.mjs",
    "start": "cd website && npm run start",
    "clean": "node -e \"const fs=require('fs'); try{fs.rmSync('website/.next',{recursive:true,force:true}); console.log('website/.next removed');}catch(e){console.error(e);}\"",
    "lint": "eslint .",
    "install:all": "npm ci && cd website && npm ci && cd ../desktop-app && npm ci",
    "desktop:sync-downloads": "node scripts/post-desktop-build.mjs",
    "release:upload": "node scripts/create-github-release.mjs",
    "release:upload:win": "node scripts/create-github-release.mjs --win",
    "release:upload:mac": "node scripts/create-github-release.mjs --mac",
    "trading:smoke-phase1": "node scripts/trading/phase1-smoke.mjs",
    "trading:run-cycle": "node scripts/trading/run-monitor-cycle.mjs",
    "trading:setup-scheduler": "node scripts/trading/setup-scheduler.mjs",
    "generate:ico": "node ./scripts/generate-ico.mjs",
    "generate:nsis-assets": "node ./scripts/desktop/generate-nsis-assets.mjs",
    "typecheck": "npm run typecheck --prefix website",
    "test": "npm run test:website && npm run test:desktop",
    "test:website": "npm run test --prefix website",
    "test:desktop": "npm run test --prefix desktop-app",
    "check:active": "npm run lint && npm run typecheck --prefix website && npm run test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/react": "^3.0.99",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.10.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react": "^7.37.5",
    "pg": "^8.18.0",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.5",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "postcss": "8.5.15",
    "uuid": "11.1.1",
    "protobufjs": "7.6.1",
    "tmp": "0.2.6"
  },
  "description": "Rearvy is a Next.js + Firebase AI business assistant for connected data, research, writing, approvals, and execution.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutalvita-cyber/rearvy2.0.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mutalvita-cyber/rearvy2.0/issues"
  },
  "homepage": "https://github.com/mutalvita-cyber/rearvy2.0#readme"
}
