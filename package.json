{
  "name": "rearvy2.0",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:dev": "concurrently -k -s first \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "electron-builder",
    "desktop:build:win": "node scripts/desktop/build-win.mjs",
    "desktop:stage-download": "node scripts/desktop/stage-download.mjs",
    "start": "next dev",
    "start:prod": "next start",
    "lint": "eslint",
    "playwright:install": "pip install browser-use",
    "browser-use:setup": "uv sync --project scripts/browser-use",
    "trading:smoke-phase1": "node scripts/trading/phase1-smoke.mjs",
    "trading:run-cycle": "node scripts/trading/run-monitor-cycle.mjs",
    "trading:setup-scheduler": "node scripts/trading/setup-scheduler.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/react": "^3.0.99",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^10.3.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.575.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react": "^7.37.5",
    "pg": "^8.18.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.rearvy.desktop",
    "productName": "Rearvy",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/**/*",
      "public/favicon.svg",
      "public/rearvy-wordmark.svg",
      "package.json",
      "!node_modules/**",
      "!.next/**",
      "!.env*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rearvy"
    }
  },
  "description": "Rearvy is a Next.js + Firebase app for AI-assisted business insights across Shopify and YouTube data.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutalvita-cyber/rearvy2.0.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mutalvita-cyber/rearvy2.0/issues"
  },
  "homepage": "https://github.com/mutalvita-cyber/rearvy2.0#readme"
}
(Get-Content package.json) -replace '"type": "commonjs"', '"type": "module"' | Set-Content package.json