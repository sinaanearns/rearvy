{
  "name": "rearvy2.0",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "cd website && npm run dev",
    "dev:desktop": "cd desktop-app && npm run dev",
    "dev:both": "concurrently \"npm run dev:web\" \"npm run dev:desktop:wait\"",
    "dev:desktop:wait": "wait-on http://localhost:3000 && cd desktop-app && npm run dev:wait",
    "build:web": "cd website && npm run build",
    "build:desktop": "cd desktop-app && npm run build",
    "build": "npm run build:web && npm run build:desktop",
    "start:web": "cd website && npm run start",
    "lint": "eslint .",
    "install:all": "npm install && cd website && npm install && cd ../desktop-app && npm install",
    "trading:smoke-phase1": "node scripts/trading/phase1-smoke.mjs",
    "trading:run-cycle": "node scripts/trading/run-monitor-cycle.mjs",
    "trading:setup-scheduler": "node scripts/trading/setup-scheduler.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "wait-on": "^9.0.5"
  },
  "description": "Rearvy is a Next.js + Firebase app for AI-assisted business insights across Shopify and YouTube data.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutalvita-cyber/rearvy2.0.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mutalvita-cyber/rearvy2.0/issues"
  },
  "homepage": "https://github.com/mutalvita-cyber/rearvy2.0#readme"
}
