# Resend API key for website email notifications
RESEND_API_KEY=your_resend_api_key_here

# Recipient for feedback emails (defaults to mutalvita@gmail.com)
FEEDBACK_RECIPIENT=mutalvita@gmail.com

# Recipient for business free access requests (defaults to myrearvy@gmail.com)
BUSINESS_FREEMIUM_RECIPIENT=myrearvy@gmail.com


# Public MetaMask checkout config. Payment wei is required before wallet checkout submits.
NEXT_PUBLIC_METAMASK_PAYMENT_ADDRESS=0x870f9677c47227C09dDDf13E8AbA7AB54AaD72fA
NEXT_PUBLIC_METAMASK_BUSINESS_PAYMENT_WEI=

# Public Google AdSense publisher id for website auto ads.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-8353196926062457

# Optional: sender address used for outgoing website emails.
# The resend.dev sender works for testing only; use a verified domain in production.
RESEND_SENDER=Rearvy <onboarding@resend.dev>

# Public Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Server-side app config
NEXT_PUBLIC_APP_URL=http://localhost:3000
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
INTEGRATION_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# AssemblyAI Voice Agent (required for hosted voice agent on the website)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_VOICE_AGENT_TOKEN_SECONDS=300
ASSEMBLYAI_VOICE_AGENT_MAX_SESSION_SECONDS=900

# Cloud Computer v1 (Browserbase-hosted browser runtime)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=us-west-2
CLOUD_COMPUTER_ENABLED=true
CLOUD_COMPUTER_MAX_ACTIVE_SESSIONS=1

# AI provider routing (server-side only)
IMAGE_GENERATION_WEB_SEARCH=true
MEDIA_IMAGE_PROVIDER=auto
MEDIA_IMAGE_EDIT_PROVIDER=nvidia
MEDIA_VIDEO_PROVIDER=auto
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2.6
NVIDIA_ROUTER_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_IMAGE_BASE_URL=
NVIDIA_IMAGE_API_KEY=
NVIDIA_IMAGE_MODEL=qwen-image-2512
NVIDIA_IMAGE_EDIT_MODEL=qwen-image-edit-2511
NVIDIA_KIMI_API_KEY=
NVIDIA_GLM_API_KEY=
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_STEP_API_KEY=
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_COSMOS_API_KEY=
NVIDIA_COSMOS_VIDEO_MODEL=nvidia/cosmos-predict1-7b
NVIDIA_COSMOS_BASE_URL=http://127.0.0.1:8000/v1
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_WORKFLOW_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_REASONING_BUDGET=16384
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_ROUTER_MODEL=llama-3.1-8b-instant

# Work Platform workers
SYNC_WORKER_SECRET=replace_with_random_sync_worker_secret
INTERNAL_API_SECRET=replace_with_random_internal_secret
WORK_SCHEDULER_SECRET=replace_with_random_scheduler_secret
WORK_RUNNER_SECRET=replace_with_random_runner_secret
AGENT_EVENTS_WORKER_SECRET=replace_with_random_agent_events_secret

# Channel provider shells. Configure only providers you activate.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WECHAT_TOKEN=
WECHAT_APP_SECRET=
DINGTALK_ROBOT_ACCESS_TOKEN=
DINGTALK_ROBOT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# Source research official APIs. Browser fallback requires approval when these are absent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RearvyWorkPlatform/1.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
