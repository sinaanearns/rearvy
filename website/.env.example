# SendGrid API key for sending feedback emails
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Recipient for feedback emails (defaults to mutalvita@gmail.com)
FEEDBACK_RECIPIENT=mutalvita@gmail.com

# Recipient for business free access requests (defaults to myrearvy@gmail.com)
BUSINESS_FREEMIUM_RECIPIENT=myrearvy@gmail.com

# Optional comma-separated Business redeem codes for quick activation.
# Firestore collection billing_redeem_codes can also store code documents.
REARVY_BUSINESS_REDEEM_CODES=Growth

# Optional Ethereum JSON-RPC URL used to verify MetaMask checkout transactions.
# Defaults to Cloudflare's public Ethereum RPC if omitted.
METAMASK_PAYMENT_RPC_URL=

# Public MetaMask checkout config. Payment wei is required before wallet checkout submits.
NEXT_PUBLIC_METAMASK_PAYMENT_ADDRESS=0x870f9677c47227C09dDDf13E8AbA7AB54AaD72fA
NEXT_PUBLIC_METAMASK_BUSINESS_PAYMENT_WEI=

# Optional: set the sender address used for outgoing feedback emails
# Note: SendGrid may require verified senders for your account
SENDGRID_SENDER=no-reply@rearvy.app

# Public Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Server-side app config
NEXT_PUBLIC_APP_URL=http://localhost:3000
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
INTEGRATION_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# AI provider routing (server-side only)
IMAGE_GENERATION_WEB_SEARCH=true
MEDIA_IMAGE_PROVIDER=nvidia
MEDIA_IMAGE_EDIT_PROVIDER=nvidia
MEDIA_VIDEO_PROVIDER=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_ROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_VIDEO_MODEL=google/veo-3.1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2.6
NVIDIA_ROUTER_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_IMAGE_BASE_URL=
NVIDIA_IMAGE_API_KEY=
NVIDIA_IMAGE_MODEL=qwen-image-2512
NVIDIA_IMAGE_EDIT_MODEL=qwen-image-edit-2511
NVIDIA_KIMI_API_KEY=
NVIDIA_GLM_API_KEY=
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_STEP_API_KEY=
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_COSMOS_API_KEY=
NVIDIA_COSMOS_VIDEO_MODEL=nvidia/cosmos-predict1-7b
NVIDIA_COSMOS_BASE_URL=http://127.0.0.1:8000/v1
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_WORKFLOW_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REASONING_BUDGET=16384
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_ROUTER_MODEL=llama3.1:8b

# Work Platform workers
SYNC_WORKER_SECRET=replace_with_random_sync_worker_secret
INTERNAL_API_SECRET=replace_with_random_internal_secret
WORK_SCHEDULER_SECRET=replace_with_random_scheduler_secret
WORK_RUNNER_SECRET=replace_with_random_runner_secret
AGENT_EVENTS_WORKER_SECRET=replace_with_random_agent_events_secret

# Channel provider shells. Configure only providers you activate.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WECHAT_TOKEN=
WECHAT_APP_SECRET=
DINGTALK_ROBOT_ACCESS_TOKEN=
DINGTALK_ROBOT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# Source research official APIs. Browser fallback requires approval when these are absent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RearvyWorkPlatform/1.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
