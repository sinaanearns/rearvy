# Primary NVIDIA API key for Rearvy AI models
NVIDIA_API_KEY=""

# Optional model-specific NVIDIA API key overrides
NVIDIA_KIMI_API_KEY=""

# File-based memory — MUST be an absolute path OUTSIDE the repository.
# On Windows:  C:\Users\<you>\AppData\Local\Rearvy\Memory
# On macOS:    /Users/<you>/.rearvy/Memory
# If unset, the code defaults to %LOCALAPPDATA%\Rearvy\Memory (Win) or ~/.rearvy/Memory (Unix).
# NEVER point this at a path inside the git workspace.
MEMORY_ROOT=


# Dodo Payments — API and Checkout
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"  # test_mode or live_mode
DODO_PAYMENTS_RETURN_URL="http://localhost:3000/chat"  # Where to send users after checkout success
DODO_PAYMENTS_WEBHOOK_SECRET=""

# Rearvy billing config
DODO_REGULAR_PRODUCT_ID="pdt_regular_monthly"  # $20/mo product you create in Dodo dashboard
DODO_EARLYBIRD_CODE="EARLYBIRD100"            # 100% off, usage_limit=100, subscription_cycles=3
